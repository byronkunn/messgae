# Copy to .env (or set in your process manager / secret store). All values are optional in development.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PUBLIC_ORIGIN=https://chat.example.com
ALLOWED_ORIGINS=https://chat.example.com
TRUST_PROXY=1

# Where the SQLite database and encrypted blobs live.
DATA_DIR=/var/lib/messgae

# 32-byte keys, base64 encoded (generate with: openssl rand -base64 32).
# Keep them OUT of the data directory and database backups. They are required in production.
APP_SECRET_KEY=
STORAGE_KEY=
FILE_PASSWORD_KEY=

# Optional tuning
# MAX_UPLOAD_BYTES=4294967296
# SCRYPT_N=32768
